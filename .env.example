# =============================================================================
# Lanettirr / Nuvio Mega Stack — Optional Environment Overrides
# Copy this file to .env and edit only the values you want to override.
# (Bu dosyayi .env olarak kopyalayip yalnizca degistirmek istediginiz alanlari duzenleyin.)
# =============================================================================

# --- Local Service Ports / Yerel Servis Portlari -----------------------------
# TR/EN Hub (trhub)
HUB_PORT=7100
# Kraptor / CS3 Bridge
BRIDGE_PORT=7000
# Unified / BlackBox service
BB_PORT=7200
# Egress proxy
EGRESS_PORT=7301
# Nuvio Mega Bridge (Stremio addon)
MEGA_PORT=3001
# Bind address for Mega Bridge (use 127.0.0.1 for local-only, 0.0.0.0 for LAN)
MEGA_HOST=127.0.0.1

# --- Optional Metadata & Media Tools / Opsiyonel Metadata ve Medya Araclari --
# Custom TMDB API key (optional; leave blank to use built-in fallback)
TMDB_API_KEY=
# Custom ffmpeg / ffprobe paths (leave blank for PATH or WinGet auto-detection)
FFMPEG_PATH=
FFPROBE_PATH=

# --- Optional Cloudflare Tunnel & AIOStreams Sync ----------------------------
# Set to 1 to start a quick Cloudflare tunnel for remote Stremio/AIOStreams use
# (Uzaktan erisim icin Cloudflare tuneli acmak isterseniz 1 yapin)
ENABLE_TUNNEL=0

# Optional AIOStreams auto-sync (used by scripts/update-aio.js)
# Example host: https://your-aiostreams-host.example
AIOSTREAMS_BASE_URL=
AIOSTREAMS_UUID=
AIOSTREAMS_PASSWORD=
# Preset instance ID in your AIOStreams config (default: nmb)
AIOSTREAMS_INSTANCE_ID=nmb
# Set to 1 ONLY if you want update-aio.js to overwrite excludedResolutions,
# sortCriteria, and the Prism formatter (0 = update manifestUrl only)
AIOSTREAMS_APPLY_PRESET=0
